{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "strictNullChecks": false,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["apps/platform/src/*"],
      "@company-web/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@company-web/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@company-web/shared/types": ["libs/shared/types/src/index.ts"],
      "@company-web/shared/data-access": ["libs/shared/data-access/src/index.ts"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
