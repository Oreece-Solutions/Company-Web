{
    "buildCommand": "yarn vercel:build",
    "outputDirectory": "dist/apps/company-website",
    "installCommand": "yarn install",
    "framework": null,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "oreece.com"
                }
            ],
            "destination": "https://www.oreece.co.nz/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.oreece.com"
                }
            ],
            "destination": "https://www.oreece.co.nz/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
